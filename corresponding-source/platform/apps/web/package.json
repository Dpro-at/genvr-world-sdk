    "@genvr/core-library": "workspace:*",
    "@genvr/film": "workspace:*",
    "@genvr/runtime": "workspace:*",
    "@genvr/script": "workspace:*",
    "@genvr/validator": "workspace:*",
    "@genvr/world-sdk": "workspace:*",
    "@huggingface/transformers": "4.2.0",
    "@mediapipe/tasks-vision": "1.1.0",
    "@mintplex-labs/piper-tts-web": "1.0.5",
    "@sentry/nextjs": "^11.0.0",
    "better-auth": "^1.7.6",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "^5.24.0",
    "next": "^16.3.6",
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c",
