{
  "name": "@genvr/web",
  "version": "0.0.0",
  "private": true,
  "description": "Genvr web app: public site, experience pages, editor shell, admin (client of the API).",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-decoders.mjs && next dev --port 3000",
    "build": "node scripts/copy-decoders.mjs && next build --webpack",
