{
  "name": "3d-world-sdk",
  "version": "0.3.0-preview.1",
  "type": "module",
  "description": "Standalone Genvr world authoring, local persistence and explicit platform publication adapters.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dpro-at/genvr-world-sdk.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "preview"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/types/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./studio": {
      "types": "./dist/studio.d.ts",
      "default": "./dist/studio.js"
    },
    "./studio.css": "./dist/studio.css",
    "./studio-project": {
      "types": "./dist/types/studio-project.d.ts",
      "default": "./dist/studio-project.js"
    }
  },
  "dependencies": {
    "zod": "4.6.5",
    "three": "0.186.1",
    "@types/three": "0.186.0",
    "@dimforge/rapier3d-compat": "0.20.0"
  },
  "bin": {
    "genvr-world-mcp": "./dist/mcp.js",
    "genvr-world-demo": "./serve.mjs",
    "genvr-studio": "./serve-studio.mjs"
  },
  "files": [
    "dist",
    "demo",
    "assets",
    "serve.mjs",
    "serve-studio.mjs",
    "README.md",
    "LICENSE"
  ]
}